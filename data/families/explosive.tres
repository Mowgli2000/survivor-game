[gd_resource type="Resource" script_class="FamilyData" format=3]

[ext_resource type="Script" path="res://src/weapons/families/family_data.gd" id="1_family"]
[ext_resource type="Script" path="res://src/weapons/families/family_bonus.gd" id="2_bonus"]
[ext_resource type="Script" path="res://src/core/stat_modifier.gd" id="3_mod"]

[sub_resource type="Resource" id="Mod_1"]
