[sub_resource type="Resource" id="Mod_1"]
script = ExtResource("2_mod")
stat = &"damage"
percent = -0.1

[resource]
script = ExtResource("1_char")
id = &"drifter"
name_key = "CHARACTER_DRIFTER"
description_key = "CHARACTER_DRIFTER_RULE"
starting_weapon = ExtResource("w0")
starting_weapons = Array[ExtResource("3_weapon_script")]([ExtResource("w0"), ExtResource("w1"), ExtResource("t_alchemy_cannon"), ExtResource("t_bazooka"), ExtResource("t_bomb"), ExtResource("t_celestial_bow"), ExtResource("t_fire_flask"), ExtResource("t_fire_staff"), ExtResource("t_frag_grenade"), ExtResource("t_frost_flask"), ExtResource("t_frost_scepter"), ExtResource("t_heavy_axe"), ExtResource("t_heavy_crossbow"), ExtResource("t_javelins"), ExtResource("t_laser_pistol"), ExtResource("t_lightning_staff"), ExtResource("t_longbow"), ExtResource("t_meteor_grimoire"), ExtResource("t_rapier"), ExtResource("t_runic_blade"), ExtResource("t_scythe"), ExtResource("t_shadow_blades"), ExtResource("t_shuriken"), ExtResource("t_sling"), ExtResource("t_smg"), ExtResource("t_spear"), ExtResource("t_steel_katana"), ExtResource("t_venom_fangs"), ExtResource("t_warhammer")])
modifiers = Array[ExtResource("2_mod")]([SubResource("Mod_1")])
upgrade_scale = 1.5
stat_overrides = {
"max_hp": 100.0,
"move_speed": 300.0
}
invulnerability_time = 0.5
radius = 16.0
color = Color(0.302, 0.784, 1, 1)
sprite_id = &"drifter"
sprite_scale = 1.35
card_art = ExtResource("card")
alt_name_key = "CHARACTER_DRIFTER_ALT"
alt_sprite_id = &"drifter_m"
alt_sprite_scale = 1.35
alt_card_art = ExtResource("card_alt")
