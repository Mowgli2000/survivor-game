[ext_resource type="Resource" path="res://data/weapons/bazooka.tres" id="w0"]
[ext_resource type="Resource" path="res://data/weapons/bomb.tres" id="w1"]

[sub_resource type="Resource" id="Mod_1"]
script = ExtResource("2_mod")
