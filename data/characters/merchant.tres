flat = 3.0

[sub_resource type="Resource" id="Mod_2"]
script = ExtResource("2_mod")
stat = &"damage"
percent = -0.1

[sub_resource type="Resource" id="Interest"]
script = ExtResource("4_interest")
percent = 0.1
cap = 25

[resource]
script = ExtResource("1_char")
id = &"merchant"
name_key = "CHARACTER_MERCHANT"
locked = true
description_key = "CHARACTER_MERCHANT_RULE"
starting_weapon = ExtResource("w0")
