[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://src/player/character_data.gd" id="1_char"]
[ext_resource type="Script" path="res://src/weapons/weapon_data.gd" id="3_weapon_script"]
[ext_resource type="Resource" path="res://data/weapons/katana.tres" id="w0"]
[ext_resource type="Resource" path="res://data/weapons/shuriken.tres" id="w1"]
[ext_resource type="Texture2D" path="res://assets/characters/cards/assassin_card.png" id="card"]

[resource]
script = ExtResource("1_char")
id = &"hero"
name_key = "CHARACTER_HERO"
description_key = "CHARACTER_HERO_RULE"
starting_weapon = ExtResource("w0")
starting_weapons = Array[ExtResource("3_weapon_script")]([ExtResource("w0"), ExtResource("w1")])
stat_overrides = {
"max_hp": 100.0,
"move_speed": 300.0
}
invulnerability_time = 0.5
radius = 16.0
color = Color(0.635, 0.349, 1, 1)
sprite_id = &"assassin"
sprite_scale = 1.35
card_art = ExtResource("card")
