[resource]
script = ExtResource("1_biome")
id = &"citadel"
name_key = "BIOME_CITADEL"
enemy_swaps = Dictionary[StringName, ExtResource("2_enemy_script")]({
&"grunt": ExtResource("e0"),
&"runner": ExtResource("e1"),
&"shooter": ExtResource("e2"),
&"tank": ExtResource("e3"),
&"charger": ExtResource("e4"),
&"kamikaze": ExtResource("e5"),
&"spawner": ExtResource("e6"),
&"ronin": ExtResource("e7"),
&"shogun": ExtResource("e8")
})
decor = ExtResource("decor")
ground_tint = Color(0.72, 0.5, 0.48, 1)
outside_color = Color(0.12, 0.05, 0.05, 1)
wall_color = Color(0.32, 0.13, 0.1, 1)
