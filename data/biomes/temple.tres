&"runner": ExtResource("e1"),
&"shooter": ExtResource("e2"),
&"tank": ExtResource("e3"),
&"charger": ExtResource("e4"),
&"kamikaze": ExtResource("e5"),
&"spawner": ExtResource("e6"),
&"ronin": ExtResource("e7"),
&"shogun": ExtResource("e8")
})
decor = ExtResource("decor")
ground_tint = Color(1.5, 1.22, 0.72, 1)
outside_color = Color(0.13, 0.1, 0.08, 1)
wall_color = Color(0.36, 0.3, 0.22, 1)
