[ext_resource type="Resource" path="res://data/enemies/silver_runner.tres" id="m_runner"]

[sub_resource type="Resource" id="P1_1_zones"]
script = ExtResource("s_zones")
windup = 1.0
recovery = 1.4
projectile_damage = 16.0
count = 5
zone_radius = 70.0
scatter = 170.0

[sub_resource type="Resource" id="P1_2_fan"]
script = ExtResource("s_fan")
windup = 0.8
repeats = 2
repeat_interval = 0.35
recovery = 1.4
projectile_speed = 340.0
count = 5
spread_degrees = 50.0

[sub_resource type="Resource" id="Phase_1"]
script = ExtResource("2_phase")
hp_ratio = 1.0
patterns = Array[ExtResource("3_pattern")]([SubResource("P1_1_zones"), SubResource("P1_2_fan")])
speed_multiplier = 1.0

[sub_resource type="Resource" id="P2_1_cone"]
