[gd_resource type="Resource" script_class="EnemyData" format=3]

[ext_resource type="Script" path="res://src/enemies/enemy_data.gd" id="1_enemy"]
[ext_resource type="Script" path="res://src/enemies/boss/boss_phase.gd" id="2_phase"]
[ext_resource type="Script" path="res://src/enemies/boss/boss_pattern.gd" id="3_pattern"]
[ext_resource type="Script" path="res://src/enemies/boss/cone_breath_pattern.gd" id="s_cone"]
[ext_resource type="Script" path="res://src/enemies/boss/dash_pattern.gd" id="s_dash"]
[ext_resource type="Script" path="res://src/enemies/boss/aimed_fan_pattern.gd" id="s_fan"]
[ext_resource type="Script" path="res://src/enemies/boss/radial_burst_pattern.gd" id="s_radial"]
[ext_resource type="Script" path="res://src/enemies/boss/summon_pattern.gd" id="s_summon"]
[ext_resource type="Script" path="res://src/enemies/boss/impact_zones_pattern.gd" id="s_zones"]
[ext_resource type="Resource" path="res://data/enemies/obsidian_kamikaze.tres" id="m_kamikaze"]
[ext_resource type="Resource" path="res://data/enemies/obsidian_runner.tres" id="m_runner"]

[sub_resource type="Resource" id="P1_1_summon"]
script = ExtResource("s_summon")
windup = 0.9
recovery = 1.6
enemy = ExtResource("m_kamikaze")
count = 4
distance = 190.0
around_target = true

[sub_resource type="Resource" id="P1_2_fan"]
script = ExtResource("s_fan")
windup = 0.8
repeats = 2
repeat_interval = 0.35
recovery = 1.4
projectile_speed = 340.0
count = 5
spread_degrees = 50.0

[sub_resource type="Resource" id="Phase_1"]
script = ExtResource("2_phase")
hp_ratio = 1.0
patterns = Array[ExtResource("3_pattern")]([SubResource("P1_1_summon"), SubResource("P1_2_fan")])
speed_multiplier = 1.0

[sub_resource type="Resource" id="P2_1_summon"]
script = ExtResource("s_summon")
windup = 0.8
recovery = 1.0
enemy = ExtResource("m_runner")
count = 6

[sub_resource type="Resource" id="P2_2_radial"]
script = ExtResource("s_radial")
windup = 0.8
repeats = 2
repeat_interval = 0.4
recovery = 1.4
count = 16
rotation_step = 11.25

[sub_resource type="Resource" id="P2_3_zones"]
script = ExtResource("s_zones")
windup = 0.9
repeats = 2
repeat_interval = 0.5
recovery = 1.2
projectile_damage = 16.0
count = 6
zone_radius = 70.0
scatter = 160.0

[sub_resource type="Resource" id="Phase_2"]
script = ExtResource("2_phase")
hp_ratio = 0.6
patterns = Array[ExtResource("3_pattern")]([SubResource("P2_1_summon"), SubResource("P2_2_radial"), SubResource("P2_3_zones")])
