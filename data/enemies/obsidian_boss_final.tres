[gd_resource type="Resource" script_class="EnemyData" format=3]

[ext_resource type="Script" path="res://src/enemies/enemy_data.gd" id="1_enemy"]
[ext_resource type="Script" path="res://src/enemies/boss/boss_phase.gd" id="2_phase"]
[ext_resource type="Script" path="res://src/enemies/boss/boss_pattern.gd" id="7_pattern"]
[ext_resource type="Resource" path="res://data/chests/big.tres" id="c_chest"]
[ext_resource type="Script" path="res://src/enemies/boss/venom_pools_pattern.gd" id="s_pools"]
[ext_resource type="Script" path="res://src/enemies/boss/venom_spit_pattern.gd" id="s_spit"]
[ext_resource type="Script" path="res://src/enemies/boss/web_net_pattern.gd" id="s_net"]
[ext_resource type="Script" path="res://src/enemies/boss/egg_clutch_pattern.gd" id="s_eggs"]
[ext_resource type="Resource" path="res://data/enemies/obsidian_runner.tres" id="larva"]
[ext_resource type="Script" path="res://src/enemies/boss/leg_cage_pattern.gd" id="s_cage"]

[sub_resource type="Resource" id="P_pools"]
script = ExtResource("s_pools")
windup = 1.0
repeats = 5
repeat_interval = 0.5
recovery = 1.3
projectile_damage = 7.0

[sub_resource type="Resource" id="P_spit"]
script = ExtResource("s_spit")
windup = 0.8
repeats = 6
repeat_interval = 0.22
recovery = 1.2
projectile_damage = 9.0

[sub_resource type="Resource" id="P_net"]
script = ExtResource("s_net")
windup = 1.0
recovery = 1.3
projectile_damage = 16.0

[sub_resource type="Resource" id="P_eggs"]
script = ExtResource("s_eggs")
windup = 1.2
recovery = 1.4
projectile_damage = 14.0
larva = ExtResource("larva")

[sub_resource type="Resource" id="P_cage"]
script = ExtResource("s_cage")
windup = 1.0
repeats = 2
repeat_interval = 0.6
recovery = 1.3
projectile_damage = 18.0

[sub_resource type="Resource" id="Phase_1"]
script = ExtResource("2_phase")
hp_ratio = 1.0
patterns = Array[ExtResource("7_pattern")]([SubResource("P_pools"), SubResource("P_spit")])
speed_multiplier = 1.0

[sub_resource type="Resource" id="Phase_2"]
script = ExtResource("2_phase")
hp_ratio = 0.6
patterns = Array[ExtResource("7_pattern")]([SubResource("P_net"), SubResource("P_eggs"), SubResource("P_cage"), SubResource("P_spit")])
speed_multiplier = 1.15

[sub_resource type="Resource" id="Phase_3"]
script = ExtResource("2_phase")
hp_ratio = 0.3
patterns = Array[ExtResource("7_pattern")]([SubResource("P_cage"), SubResource("P_pools"), SubResource("P_eggs"), SubResource("P_net"), SubResource("P_spit")])
speed_multiplier = 1.3

[resource]
script = ExtResource("1_enemy")
id = &"obsidian_boss_final"
name_key = "ENEMY_OBSIDIAN_BOSS_FINAL"
boss = true
max_hp = 3250.0
speed = 75.0
contact_damage = 30.0
armor = 8.0
radius = 48.0
knockback_taken = 0.0
xp_value = 0
color = Color(0.6, 1.0, 0.3, 1)
shape_sides = 8
sprite_id = &"obsidian_boss_final"
sprite_scale = 1.15
phases = Array[ExtResource("2_phase")]([SubResource("Phase_1"), SubResource("Phase_2"), SubResource("Phase_3")])
projectile_style = 20
chest = ExtResource("c_chest")
