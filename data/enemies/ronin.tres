[ext_resource type="Script" path="res://src/enemies/boss/dash_pattern.gd" id="5_dash"]
[ext_resource type="Script" path="res://src/enemies/boss/summon_pattern.gd" id="6_summon"]
[ext_resource type="Script" path="res://src/enemies/boss/boss_pattern.gd" id="7_pattern"]

[sub_resource type="Resource" id="P1_dash"]
script = ExtResource("5_dash")
windup = 0.8
recovery = 1.4
dash_speed = 800.0
dash_duration = 0.5

[sub_resource type="Resource" id="P1_fan"]
script = ExtResource("4_fan")
