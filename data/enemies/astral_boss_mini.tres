scatter = 160.0

[sub_resource type="Resource" id="P2_3_dash"]
script = ExtResource("s_dash")
windup = 0.6
recovery = 1.0
dash_speed = 950.0
dash_duration = 0.5

[sub_resource type="Resource" id="Phase_2"]
script = ExtResource("2_phase")
hp_ratio = 0.5
patterns = Array[ExtResource("3_pattern")]([SubResource("P2_1_cone"), SubResource("P2_2_zones"), SubResource("P2_3_dash")])
