[gd_resource type="Resource" script_class="EnemyData" format=3]

[ext_resource type="Script" path="res://src/enemies/enemy_data.gd" id="1_enemy"]
[ext_resource type="Script" path="res://src/enemies/boss/boss_phase.gd" id="2_phase"]
[ext_resource type="Script" path="res://src/enemies/boss/boss_pattern.gd" id="3_pattern"]
[ext_resource type="Script" path="res://src/enemies/boss/cone_breath_pattern.gd" id="s_cone"]
[ext_resource type="Script" path="res://src/enemies/boss/dash_pattern.gd" id="s_dash"]
[ext_resource type="Script" path="res://src/enemies/boss/impact_zones_pattern.gd" id="s_zones"]

[sub_resource type="Resource" id="P1_1_zones"]
script = ExtResource("s_zones")
windup = 0.9
recovery = 1.4
projectile_damage = 14.0
count = 4
zone_radius = 70.0
scatter = 170.0

[sub_resource type="Resource" id="P1_2_dash"]
script = ExtResource("s_dash")
windup = 0.8
recovery = 1.4
dash_speed = 850.0
dash_duration = 0.5

[sub_resource type="Resource" id="Phase_1"]
script = ExtResource("2_phase")
hp_ratio = 1.0
patterns = Array[ExtResource("3_pattern")]([SubResource("P1_1_zones"), SubResource("P1_2_dash")])
speed_multiplier = 1.0

[sub_resource type="Resource" id="P2_1_cone"]
script = ExtResource("s_cone")
