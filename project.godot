, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":11,"pressed":true,"script":null)
]
}
move_down={
"deadzone": 0.2,
