"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194308,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":1,"pressed":true,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.fr.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
