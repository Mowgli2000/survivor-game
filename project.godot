, Object(InputEventKey,"device":-1,"physical_keycode":4194322,"script":null)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":12,"pressed":true,"script":null)
]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305,"script":null)
, Object(InputEventKey,"device":-1,"physical_keycode":80,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":6,"pressed":true,"script":null)
]
}
confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194309,"script":null)
, Object(InputEventKey,"device":-1,"physical_keycode":32,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":true,"script":null)
]
}
