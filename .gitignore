# Godot cache / generated
.godot/
.import/
*.translation
*.tmp
*.TMP

# Builds & exports
builds/
export/
*.pck
*.exe
*.zip

# Export credentials / secrets (never commit)
export_credentials.cfg
.env
*.env
**/steamcmd_credentials*
**/*secret*
**/*.key

# Steam dev file (keep local only)
steam_appid.txt

# Mono / C# (not used, safety)
.mono/
data_*/
mono_crash.*.json

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp

# Claude Code local settings
.claude/settings.local.json

# Raw third-party asset packs (only processed files under assets/ are committed)
assets_src/
.superpowers/

# Git Bash crash dumps
*.stackdump

# Art showcase: third-party references (not ours to redistribute) and generated SVGs (node art_showcase/tools/export_assets.js)
art_showcase/references/
art_showcase/assets/

# Raw art inputs (often third-party or not yet cleared) and the AI sprite placeholder
art_source/incoming/*
!art_source/incoming/.gitkeep
assets_src/ai/ai_test/

# AI art test images (local only)
art_tests/
__pycache__/
